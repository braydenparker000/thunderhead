+/// Headers of a RAF as [`decode`] reads them, without samples, for hosts that stream the samples with
+/// [`decode_columns`]: the white level is the nominal `2^bits − 1` (a full decode measures it from the samples).
+pub fn decode_header(bytes: &[u8]) -> Result<RawImage> {
+    let mut img = decode(bytes, Mode::Header)?;
+    img.white = vec![((1u32 << img.bits.clamp(1, 16)) - 1) as f32];
+    Ok(img)
+}
+
+/// Sensor columns `[x0, x1)` of a RAF (raw-data coordinates, margins included), handed to `sink(band_x0,
+/// band_width, samples)` band by band from left to right, each band full height and row-major. Compressed files
+/// decode only the 768-px stripes the columns overlap, one at a time; uncompressed files unpack only those
+/// columns, in 256-px bands. Peak extra memory is one band.
+pub fn decode_columns(bytes: &[u8], x0: usize, x1: usize, sink: &mut dyn FnMut(usize, usize, &[u16])) -> Result<()> {
+    let h = header(bytes)?;
+    let raw = h.raw.ok_or_else(|| RawError::Corrupt("RAF without raw data".into()))?;
+    let ifd = raw_ifd(raw)?;
+    let get = |t: u16| ifd.u64(t).map(|v| usize::try_from(v).map_err(|_| RawError::Limit("RAF IFD value too large"))).transpose();
+    let (w, hgt) = (get(0xf001)?.unwrap_or(0), get(0xf002)?.unwrap_or(0));
+    let bits = ifd.u64(0xf003).and_then(|v| u32::try_from(v).ok()).unwrap_or(0);
+    let (off, len) = (get(0xf007)?.unwrap_or(0), get(0xf008)?.unwrap_or(0));
+    if w == 0 || hgt == 0 || !(8..=16).contains(&bits) {
+        return Err(RawError::Corrupt(format!("RAF raw IFD: {w}x{hgt}, {bits} bits")));
+    }
+    let n = w.checked_mul(hgt).filter(|n| *n <= crate::MAX_SAMPLES).ok_or(RawError::Limit("image too large"))?;
+    let src = raw
+        .get(off..off.checked_add(len).ok_or_else(|| RawError::Corrupt("RAF strip size overflow".into()))?)
+        .ok_or_else(|| RawError::Corrupt("RAF strip outside file".into()))?;
+    let (x0, x1) = (x0.min(w), x1.min(w));
+    if be32(bytes, 108).unwrap_or(0) != 0 {
+        return super::rafc::decode_columns(src, w, hgt, bits, cfa(&h).width == 6, x0, x1, sink);
+    }
+    let words32 = ifd.u64(PACKED_WORDS).is_some_and(|v| v != 0);
+    let store = if len as u64 >= (n as u64) * 2 { 16 } else { bits };
+    let packed_row = w.checked_mul(store as usize).map(|n| n.div_ceil(8)).ok_or(RawError::Limit("RAF row too large"))?;
+    let stride = match get(0xf005)?.unwrap_or(0) {
+        0 => packed_row,
+        words => words.checked_mul(4).ok_or(RawError::Limit("RAF stride too large"))?.max(packed_row),
+    };
+    let required = stride.checked_mul(hgt - 1).and_then(|n| n.checked_add(packed_row)).ok_or(RawError::Limit("RAF strip too large"))?;
+    if len < required {
+        return Err(RawError::Unsupported(format!("Fujifilm RAF packing ({len} bytes for {w}x{hgt} {bits}-bit)")));
+    }
+    let mut row = if store == 16 { Vec::new() } else { vec![0u16; w] };
+    let mut band = Vec::new();
+    // narrower bands than the compressed stripes: an uncompressed band is only a copy, so keep it small
+    for bx in (x0..x1).step_by(256) {
+        let bw = 256.min(x1 - bx);
+        band.clear();
+        band.reserve(bw * hgt);
+        for y in 0..hgt {
+            let s = src.get(y * stride..y * stride + packed_row).unwrap_or(&[]);
+            if store == 16 {
+                let cols = s.get(bx * 2..(bx + bw) * 2).unwrap_or(&[]);
+                band.extend(cols.as_chunks::<2>().0.iter().map(|c| u16::from_le_bytes(*c)));
+            } else {
+                unpack_row(s, store, words32, &mut row);
+                band.extend_from_slice(&row[bx..bx + bw]);
+            }
+        }
+        band.resize(bw * hgt, 0);
+        sink(bx, bw, &band);
+    }
+    Ok(())
+}
+
+/// The sensor's column stripes, each decoded on its own six rows at a time (compressed files: their 768-px stripes;
+/// uncompressed: 768-px bands), so a host can decode several at once, one per thread, holding a few rows of each.
+pub struct Stripes<'a> {
+    src: &'a [u8],
+    compressed: Option<(Vec<super::rafc::Stripe<'a>>, bool)>,
+    /// raw-data width and height (margins included)
+    pub width: usize,
+    pub height: usize,
+    bits: u32,
+    store: u32,
+    stride: usize,
+    packed_row: usize,
+    words32: bool,
+}
+
+impl Stripes<'_> {
+    pub fn len(&self) -> usize {
+        self.compressed.as_ref().map_or(self.width.div_ceil(768), |(s, _)| s.len())
+    }
+    pub fn is_empty(&self) -> bool {
+        self.len() == 0
+    }
+    /// Stripe `i`'s raw-data columns: `(x0, width)`.
+    pub fn columns(&self, i: usize) -> (usize, usize) {
+        (i * 768, 768.min(self.width.saturating_sub(i * 768)))
+    }
+    /// Stripe `i` handed to `sink(first_row, rows)` six rows at a time, row-major at the stripe's width.
+    pub fn decode_rows(&self, i: usize, sink: &mut dyn FnMut(usize, &[u16])) -> Result<()> {
+        if let Some((stripes, xtrans)) = &self.compressed {
+            let s = stripes.get(i).ok_or_else(|| RawError::Corrupt("RAF stripe out of range".into()))?;
+            return super::rafc::decode_stripe_rows(s, self.height, self.bits, *xtrans, sink);
+        }
+        let (bx, bw) = self.columns(i);
+        let mut row = if self.store == 16 { Vec::new() } else { vec![0u16; self.width] };
+        let mut rows = Vec::with_capacity(6 * bw);
+        for y0 in (0..self.height).step_by(6) {
+            rows.clear();
+            for y in y0..(y0 + 6).min(self.height) {
+                let s = self.src.get(y * self.stride..y * self.stride + self.packed_row).unwrap_or(&[]);
+                if self.store == 16 {
+                    let cols = s.get(bx * 2..(bx + bw) * 2).unwrap_or(&[]);
+                    rows.extend(cols.as_chunks::<2>().0.iter().map(|c| u16::from_le_bytes(*c)));
+                } else {
+                    unpack_row(s, self.store, self.words32, &mut row);
+                    rows.extend_from_slice(&row[bx..bx + bw]);
+                }
+                rows.resize((y + 1 - y0) * bw, 0);
+            }
+            sink(y0, &rows);
+        }
+        Ok(())
+    }
+}
+
+/// The stripes of a RAF's raw data, for [`Stripes::decode_rows`].
+pub fn stripes(bytes: &[u8]) -> Result<Stripes<'_>> {
+    let h = header(bytes)?;
+    let raw = h.raw.ok_or_else(|| RawError::Corrupt("RAF without raw data".into()))?;
+    let ifd = raw_ifd(raw)?;
+    let get = |t: u16| ifd.u64(t).map(|v| usize::try_from(v).map_err(|_| RawError::Limit("RAF IFD value too large"))).transpose();
+    let (w, hgt) = (get(0xf001)?.unwrap_or(0), get(0xf002)?.unwrap_or(0));
+    let bits = ifd.u64(0xf003).and_then(|v| u32::try_from(v).ok()).unwrap_or(0);
+    let (off, len) = (get(0xf007)?.unwrap_or(0), get(0xf008)?.unwrap_or(0));
+    if w == 0 || hgt == 0 || !(8..=16).contains(&bits) {
+        return Err(RawError::Corrupt(format!("RAF raw IFD: {w}x{hgt}, {bits} bits")));
+    }
+    let n = w.checked_mul(hgt).filter(|n| *n <= crate::MAX_SAMPLES).ok_or(RawError::Limit("image too large"))?;
+    let src = raw
+        .get(off..off.checked_add(len).ok_or_else(|| RawError::Corrupt("RAF strip size overflow".into()))?)
+        .ok_or_else(|| RawError::Corrupt("RAF strip outside file".into()))?;
+    let mut s = Stripes { src, compressed: None, width: w, height: hgt, bits, store: 16, stride: 0, packed_row: 0, words32: false };
+    if be32(bytes, 108).unwrap_or(0) != 0 {
+        let xtrans = cfa(&h).width == 6;
+        s.compressed = Some((super::rafc::parse(src, w, hgt, bits, xtrans)?.1, xtrans));
+        return Ok(s);
+    }
+    s.words32 = ifd.u64(PACKED_WORDS).is_some_and(|v| v != 0);
+    s.store = if len as u64 >= (n as u64) * 2 { 16 } else { bits };
+    s.packed_row = w.checked_mul(s.store as usize).map(|n| n.div_ceil(8)).ok_or(RawError::Limit("RAF row too large"))?;
+    s.stride = match get(0xf005)?.unwrap_or(0) {
+        0 => s.packed_row,
+        words => words.checked_mul(4).ok_or(RawError::Limit("RAF stride too large"))?.max(s.packed_row),
+    };
+    let required = s.stride.checked_mul(hgt - 1).and_then(|n| n.checked_add(s.packed_row)).ok_or(RawError::Limit("RAF strip too large"))?;
+    if len < required {
+        return Err(RawError::Unsupported(format!("Fujifilm RAF packing ({len} bytes for {w}x{hgt} {bits}-bit)")));
+    }
+    Ok(s)
+}
