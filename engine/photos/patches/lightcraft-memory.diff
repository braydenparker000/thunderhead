+/// The stripes overlapping sensor columns `[x0, x1)`, decoded one at a time and handed to `sink(stripe_x0,
+/// stripe_width, samples)` (full height, row-major), so a host holds one stripe instead of the whole mosaic.
+pub(super) fn decode_columns(
+    src: &[u8],
+    width: usize,
+    height: usize,
+    bits: u32,
+    xtrans: bool,
+    x0: usize,
+    x1: usize,
+    sink: &mut dyn FnMut(usize, usize, &[u16]),
+) -> Result<()> {
+    let (_, stripes) = parse(src, width, height, bits, xtrans)?;
+    for (i, stripe) in stripes.iter().enumerate() {
+        let sx = i * BLOCK;
+        if sx + stripe.width <= x0 || sx >= x1 {
+            continue;
+        }
+        let data = decode_stripe(stripe, height, bits, xtrans)?;
+        sink(sx, stripe.width, &data);
+    }
+    Ok(())
+}
