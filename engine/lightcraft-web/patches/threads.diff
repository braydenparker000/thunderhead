@@ -24,6 +24,7 @@ log = { workspace = true }
 crc32fast = { workspace = true }
 
 [target.'cfg(target_arch = "wasm32")'.dependencies]
+wasm-bindgen-rayon = { version = "1.3", features = ["no-bundler"], optional = true }
