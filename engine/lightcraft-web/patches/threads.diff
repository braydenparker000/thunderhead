 egui = { workspace = true }
 wasm-bindgen = { workspace = true }
@@ -81,6 +82,9 @@ web-sys = { workspace = true, features = [
 # it (HEVC patents); build with `--features heif` to include it. On wasm32 panics abort, so
 # heic-rs's `catch_unwind` guard does not apply there.
 heif = ["lightcraft-codecs/heif"]
+# Thunderhead: rayon on Web Workers (wasm-bindgen-rayon) for a render worker on a cross-origin isolated
