{
  "compilerOptions": {
    "target": "es2024",
    "lib": ["es2024"],
    "module": "es2022",
    "moduleResolution": "bundler",
    "strict": true,
    "noUncheckedIndexedAccess": false,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "isolatedModules": true,
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": false,
    "skipLibCheck": true,
    // The scripture parser is one JS module shared with the phone (frontend/apps/study/scripture).
    "allowJs": true,
    "noEmit": true,
    "types": ["./worker-configuration.d.ts", "@types/node", "@cloudflare/vitest-plugin/types", "vite/client"]
  },
  "include": ["src", "tests", "bench", "vitest.config.ts", "../shared/contract"]
}
