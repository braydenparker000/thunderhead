// The Cloudflare Worker thunderhead-api (free plan). Everything here is public: no account IDs,
// no secrets, no real origins. Secrets are listed in README.md and set by the deploy
// workflow, never from a Claude session.
{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "thunderhead-api",
  "main": "src/index.ts",
  // nodejs_compat (needed for node:crypto scrypt) is on by default from 2026-08-04; the flag is
  // listed anyway so the requirement is visible and survives a date change.
  "compatibility_date": "2026-10-15",
  "compatibility_flags": ["nodejs_compat"],
  // No usage metrics leave a developer's or agent's machine.
  "send_metrics": false,
  "workers_dev": true,
  "preview_urls": false,
  // Every var is declared here; nothing set in the dashboard survives a deploy.
  "keep_vars": false,
  "observability": { "enabled": true, "head_sampling_rate": 1 },
  "triggers": { "crons": ["*/15 * * * *"] },
  "version_metadata": { "binding": "VERSION" },
  "durable_objects": {
    "bindings": [
      { "name": "CORE", "class_name": "Core" },
      { "name": "AUTH", "class_name": "Auth" },
      { "name": "MUSIC", "class_name": "Music" }
    ]
  },
  // Classic migrations array (decision: not the newer `exports` field, which cannot be undone).
  // A class added later gets its own tag in its own deploy, because rollback cannot cross it.
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["Core", "Auth"] },
    // P5: the Music object, shipped alone (its own deploy, no rollback across it).
    { "tag": "v2", "new_sqlite_classes": ["Music"] }
  ],
  // The private bucket (DATA.md §7.1, SETUP.md J2): never public, no r2.dev, no custom domain.
  // P3 keeps the old Worker's export parts and manifest in it (imports/old/). A rollback stays
  // safe while the bucket exists; without the binding (local dev, older configs) the routes
  // that need it answer 503 not_configured.
  // `jarvis-music` (MEDIA, DATA.md §7.2) is shared with the old Worker: this Worker stores only the
  // upload tools' verified audio and art there, once each under its content address, and never
  // deletes from it (areas/music/upload.ts; the no-music-delete test). Phones read it by signed link.
  "r2_buckets": [
    { "binding": "VAULT", "bucket_name": "thunderhead-private" },
    { "binding": "MEDIA", "bucket_name": "jarvis-music" }
  ],
  // Secret names only; values never live in files. Listing them makes a deploy refuse to ship
  // without them, and is also what lets local dev load them from .dev.vars. A secret that is not
  // configured yet holds the literal `none` (the deploy writes it); nothing ever runs
  // `wrangler secret delete` on a listed name. ROUTINE_CHAT_URL/TOKEN are the mind-chat task's
  // API trigger (SETUP.md K), ROUTINE_NIGHT_URL/TOKEN the mind-night task's (SETUP.md L1),
  // ROUTINE_REFLEX_URL/TOKEN the mind-reflex task's (SETUP.md M2); while a pair is `none` that
  // task is never fired. R2_SIGN_ACCESS_KEY_ID/SECRET are the read-only R2 token that signs media
  // links (SECURITY.md §9, SETUP.md N1); while either is `none`, POST /v1/media/sign answers 503.
  // MUSIC_UPLOAD_PUBLIC_KEYS is the upload tools' public keys, a JSON list (SETUP.md N4); while it
  // is `none`, /v1/music/uploads/* answers 503.
  "secrets": {
    "required": [
      "AUTH_PEPPER",
      "IP_HASH_KEY",
      "AUTH_SETUP_FP",
      "AUTH_RESET_FP",
      "ROUTINE_CHAT_URL",
      "ROUTINE_CHAT_TOKEN",
      "ROUTINE_NIGHT_URL",
      "ROUTINE_NIGHT_TOKEN",
      "ROUTINE_REFLEX_URL",
      "ROUTINE_REFLEX_TOKEN",
      "R2_SIGN_ACCESS_KEY_ID",
      "R2_SIGN_SECRET",
      "MUSIC_UPLOAD_PUBLIC_KEYS"
    ]
  },
  "vars": {
    // Exact site origins allowed by CORS, comma-separated. The real value comes from the
    // `worker` environment through `wrangler deploy --var`; this placeholder matches nothing real.
    "SITE_ORIGINS": "https://thunderhead.zNN.web.core.windows.net",
    // The account's R2 host for signed media links (`<id>.r2.cloudflarestorage.com`). The real id
    // comes from the `worker` environment's CLOUDFLARE_ACCOUNT_ID through `--var`, never this file.
    "R2_ACCOUNT_ID": "none",
    // Fallback only. The owner's real time zone is the private Core setting `owner.tz`, set from
    // the phone, never written in this public repo.
    "OWNER_TZ": "UTC",
    // The Have I Been Pwned range check on new passwords ("on" | "off"). Tests set "off".
    "AUTH_HIBP": "on",
    // How GET /v1/live/wait learns of a change: "ws" (a held socket to Core) or "poll" (every 3 s),
    // the fallback if measurement X1 fails (areas/feed/wait.ts).
    "LIVE_WAIT": "ws"
  }
}
