  "verbs": {
    "app.open": {
      "app": "shell",
      "class": "reversible",
      "executor": "device",
      "queueable": false,
      "undo": "none",
      "doc": "Opens an app at a place. Runs only when the owner taps a reply's action chip; the mind never opens an app by itself (BEHAVIOR.md §2.2).",
      "versions": {
        "1": {
          "args": {
            "type": "object",
            "properties": {
              "app": {
                "type": "string",
                "enum": [
                  "music",
                  "guitar",
                  "podcasts",
                  "astra",
                  "media",
                  "study"
                ]
              },
              "path": {
                "type": "string",
                "minLength": 1,
                "maxLength": 200,
                "pattern": "^\\/[A-Za-z0-9._~!$&'()*+,;=:@/?#%-]*$"
              }
            },
            "required": [
              "app",
              "path"
            ]
          },
          "result": {
            "type": "object",
            "properties": {}
          }
        }
      }
    },
    "shell.appearance": {
      "app": "shell",
      "class": "reversible",
      "executor": "device",
      "queueable": true,
      "undo": "reported",
      "doc": "Sets the phone's appearance (auto, day or night). The phone reports the previous mode as the undo.",
      "versions": {
        "1": {
          "args": {
            "type": "object",
            "properties": {
              "mode": {
                "type": "string",
                "enum": [
                  "auto",
                  "day",
                  "night"
                ]
              }
            },
            "required": [
              "mode"
            ]
          },
          "result": {
            "type": "object",
            "properties": {
              "previous": {
                "type": "string",
                "enum": [
                  "auto",
                  "day",
                  "night"
                ]
              }
            },
            "required": [
              "previous"
            ]
          }
        }
      }
    }
  },
