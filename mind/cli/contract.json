        "1": {
          "type": "object",
          "properties": {
            "text": {
              "type": "string",
              "minLength": 2,
              "maxLength": 44
            },
            "lang": {
              "type": "string",
              "pattern": "^[a-z]{2,3}(-[A-Z]{2})?$"
            }
          },
          "required": [
            "text"
          ]
        }
      }
    }
