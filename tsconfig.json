{
  // Type-checks the frontend's JSDoc against shared/contract (decision X5). No emit, no build:
  // the browser runs frontend/ as written. The backend has its own tsconfig in backend/.
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "strict": true,
    "target": "es2024",
    "module": "es2022",
    "moduleResolution": "bundler",
    "lib": ["es2024", "dom", "dom.iterable"],
    "types": [],
    "skipLibCheck": true,
    // The site's own root-absolute imports (Study's modules import /th/… as the browser does).
    "paths": { "/th/*": ["./frontend/th/*"], "/config.js": ["./frontend/config.js"] }
  },
  "include": ["frontend/th/**/*.js", "frontend/apps/study/**/*.js", "shared/**/*.ts"],
  // The music player's worker script runs in a classic service worker (worker globals, no DOM) and
  // is no API client; tests/music-bridge*.test.mjs check it. th/astra/ imports Astra's own untyped
  // modules; tests/astra-open*.test.mjs check it.
  "exclude": ["frontend/th/music/**", "frontend/th/astra/**"]
}
